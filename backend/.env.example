# Base URL for the OpenAI-compatible LLM endpoint (calls /v1/chat/completions)
LLM_BASE_URL=http://localhost:11434/v1

# API key for the LLM provider (not needed for local Ollama, but required for hosted providers)
LLM_API_KEY=unused-for-local-ollama

# Model name served by the OpenAI-compatible endpoint
LLM_MODEL=llama3.1

# Persistent storage directory for Chroma vector store and SQLite audit logs
DATA_DIR=./data

# Comma-separated list of allowed CORS origins for FastAPI
ALLOWED_ORIGINS=http://localhost:5173
